---
// WHO YOU WILL MEET (id about). Designed around the photos Thulaib sends: Mr. Janaka upright 4:5 with the team 3:2
// over its lower corner, four staff frames and the two offices. The heading is the grid's first child so the About link lands on
// it on a phone; on a desk it sits at the top of the words column beside the portrait. Until they arrive every frame is a PHOTO NEEDED box
// that says what to send (Shot real).
import '../styles/team.css';
import Icon from './Icon.astro';
import Ph from './Ph.astro';
import Shot from './Shot.astro';
import { SITE } from '../config.js';
const officePics = {
  head: { name: 'real-office-ambalantota', need: 'the Ambalantota office with its signboard, wide 16:9' },
  colombo: { name: 'real-office-colombo', need: 'the Colombo branch office, wide 3:2' },
};
---
<section class="tm" id="about" aria-labelledby="about-h">
  <div class="tm-in frame">
    <div class="tm-grid">
      <h2 id="about-h" class="tm-h" data-reveal>Who you will meet</h2>
      <div class="tm-photos" data-reveal="left">
        <div class="tm-lead drift"><Shot real name="real-janaka" need="Mr. Janaka, head and shoulders, upright 4:5" sizes="(min-width: 1100px) 560px, 80vw" /></div>
        <div class="tm-team"><div class="tm-team-in"><Shot real name="real-team" need="Mr. Janaka with the team at the Ambalantota office, wide 3:2" sizes="(min-width: 1100px) 360px, 60vw" /></div></div>
      </div>

      <div class="tm-copy">
        <figure class="tm-quote" data-reveal>
          <Icon name="quote" class="tm-qm" />
          <blockquote><p>Mr. Janaka leads Rathnaweera Foreign Employment Agency. <Ph t="a few lines on how the agency started, in his words" /></p></blockquote>
        </figure>

        <div class="tm-staff" data-stagger>
          {[1, 2, 3, 4].map(n => (
            <figure class="tm-person" data-reveal>
              <div class="tm-face"><Shot real name={`real-staff-${n}`} need="staff member, square" sizes="120px" widths={[160, 320]} /></div>
              <figcaption><span class="tm-name"><Ph t="name" /></span><span class="tm-role"><Ph t="role" /></span></figcaption>
            </figure>
          ))}
        </div>

        <div class="tm-offices" data-stagger>
          {SITE.offices.map(o => (
            <article class="tm-office" data-reveal>
              <div class="tm-opic"><Shot real name={officePics[o.key].name} need={officePics[o.key].need} sizes="(min-width: 1100px) 340px, 92vw" /></div>
              <div class="tm-obody">
                <h3 class="tm-ot">{o.name}</h3>
                <p class="tm-op"><Icon name="pin" />{o.town}</p>
                <p class="tm-oa"><Ph t="full address" /></p>
              </div>
            </article>
          ))}
        </div>
        <p class="tm-more tm-desk"><Ph t="About us and our licence, page follows after approval" /></p>
      </div>
    </div>
  </div>
</section>
