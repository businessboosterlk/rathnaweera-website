---
// Rathnaweera home page, staging preview. This page only joins the sections: each one is its own component with
// its own styles and behaviour. Every fact that waits for Janaka is a gold dashed placeholder from config.js.
// Every job and country is a SAMPLE. The form is a front-end preview: it sends nothing anywhere (bb_pending 1242).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Ticker from '../components/Ticker.astro';
import Jobs from '../components/Jobs.astro';
import WorldMap from '../components/WorldMap.astro';
import Stages from '../components/Stages.astro';
import Ready from '../components/Ready.astro';
import Apply from '../components/Apply.astro';
import Safety from '../components/Safety.astro';
import Guides from '../components/Guides.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Header />
  <main>
    <Hero />
    <TrustStrip /><Ticker />
    <Jobs />
    <WorldMap />
    <Stages />
    <Ready />
    <Apply />
    <Safety />
    <Guides />
    <Team />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
